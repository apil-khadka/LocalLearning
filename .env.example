# No live endpoints or credentials are checked into this repository.
# Copy to .env. Blank URLs intentionally produce honest unavailable states.
AI_ENABLED=false
ADMIN_TOKEN=
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen3:4b-instruct
EMBED_MODEL=embeddinggemma
EMBED_QUERY_PREFIX="task: search result | query: "
EMBED_DOCUMENT_PREFIX="title: {title} | text: "
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=dh_curriculum_v1
KIWIX_PUBLIC_URL=
KIWIX_PROBE_URL=
KOLIBRI_PUBLIC_URL=
KOLIBRI_PROBE_URL=
# Docker publishes the student portal only. Staff stays on host loopback.
PORTAL_BIND=127.0.0.1
PORTAL_PORT=8090
STAFF_PORT=8091
MODEL_TIMEOUT_SECONDS=120
DEPENDENCY_TIMEOUT_SECONDS=3
MAX_UPLOAD_BYTES=10485760
MAX_PDF_PAGES=100
MAX_CHAT_CONCURRENCY=1
# Starting value, not a validated relevance guarantee. Calibrate on approved curriculum.
RETRIEVAL_THRESHOLD=0.65
RETRIEVAL_TOP_K=4
