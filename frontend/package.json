{
  "name": "digital-himalaya-portal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/collect-notices.mjs",
    "check": "tsc -b && eslint . --max-warnings=0",
    "test:e2e": "playwright test",
    "format": "prettier --config .prettierrc.json --write src e2e scripts *.ts *.js *.json ../site/*.html ../site/*.css ../site/*.js",
    "format:check": "prettier --config .prettierrc.json --check src e2e scripts *.ts *.js *.json ../site/*.html ../site/*.css ../site/*.js"
  },
  "dependencies": {
    "@fontsource/noto-sans-devanagari": "5.2.5",
    "@fontsource/nunito-sans": "5.2.6",
    "@phosphor-icons/react": "2.1.10",
    "@radix-ui/react-toggle-group": "1.1.11",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.55.1",
    "@types/node": "22.18.6",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.4",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "16.4.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.72.0",
    "vite": "7.3.7"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
